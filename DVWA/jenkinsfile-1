pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/Sec-DO/Automated-CI-CD-and-Security-Compliance-Pipeline-for-Cloud-Applications.git'
        BRANCH = 'main'
        COMPOSE_PROJECT = 'dvwa'
        TARGET_URL = 'http://15.252.71.195:4280'
		EMAIL_TO = 'patilrahulprafulla1@gmail.com,rushikeshdange49@gmail.com,ameybhalerao004@gmail.com,ashutoshkabade1961@gmail.com,dangerushi19@gmail.com'
    }

    options {
        timestamps()
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Source Code') {
            steps {
                git branch: "${BRANCH}", url: "${REPO_URL}"
            }
        }

        stage('Verify Environment') {
            steps {
                sh '''
                echo "========================================"
                echo "Docker Version"
                docker --version

                echo ""
                echo "Docker Compose Version"
                docker compose version

                echo ""
                echo "Docker Buildx Version"
                docker buildx version || true

                echo ""
                echo "Trivy Version"
                trivy --version

                echo ""
                echo "Repository Structure"
                pwd
                ls -la
                ls -la DVWA
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('DVWA') {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        withSonarQubeEnv('SonarScanner') {
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Deploy DVWA') {
            steps {
                dir('DVWA') {
                    sh '''
                    docker compose -p ${COMPOSE_PROJECT} down || true
                    docker compose -p ${COMPOSE_PROJECT} pull
                    docker compose -p ${COMPOSE_PROJECT} up -d
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                mkdir -p trivy-reports

                echo "========================================"
                echo "Scanning DVWA Image"
                echo "========================================"

                trivy image \
                  --severity HIGH,CRITICAL \
                  --format table \
                  --exit-code 0 \
                  -o trivy-reports/dvwa-report.txt \
                  ghcr.io/digininja/dvwa:latest

                echo "========================================"
                echo "Scanning MariaDB Image"
                echo "========================================"

                trivy image \
                  --severity HIGH,CRITICAL \
                  --format table \
                  --exit-code 0 \
                  -o trivy-reports/mariadb-report.txt \
                  mariadb:10

                cat trivy-reports/dvwa-report.txt
                cat trivy-reports/mariadb-report.txt
                '''
            }
        }

        stage('OWASP ZAP Scan') {
            steps {
                script {

                    sh 'mkdir -p zap-reports'

                    int zapStatus = sh(
                        script: """
                        docker run --rm \
                          --network host \
                          --user root \
                          -v \$(pwd)/zap-reports:/zap/wrk \
                          ghcr.io/zaproxy/zaproxy:stable \
                          zap-baseline.py \
                          -t ${TARGET_URL} \
                          -r zap-report.html
						  # -r zap-report.txt
                        """,
                        returnStatus: true
                    )

                    echo "ZAP Exit Code: ${zapStatus}"

                    if (zapStatus == 3) {
                        error("OWASP ZAP execution failed.")
                    }

                    if (zapStatus == 1) {
                        error("OWASP ZAP detected FAIL findings.")
                    }

                    if (zapStatus == 2) {
                        echo "OWASP ZAP reported WARN findings. Continuing pipeline."
                    }

                    sh '''
                    echo "Generated Reports"
                    ls -lah zap-reports || true
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                dir('DVWA') {
                    sh '''
                    echo "========================================"
                    echo "Running Containers"
                    docker ps

                    echo ""
                    docker compose -p ${COMPOSE_PROJECT} ps

                    echo ""
                    echo "Docker Images"
                    docker images
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "========================================"
            echo "Pipeline completed successfully!"
            echo "DVWA deployed successfully."
            echo "SonarQube completed."
            echo "Trivy completed."
            echo "OWASP ZAP completed."
            echo "========================================"
        }

        failure {
            echo "========================================"
            echo "Pipeline Failed!"
            echo "========================================"
        }

        always {

            archiveArtifacts(
                artifacts: 'trivy-reports/*.txt,zap-reports/*.html',
                fingerprint: true,
                allowEmptyArchive: true
            )

            emailext(
                to: "${EMAIL_TO}",
                subject: "SecDO Pipeline - ${currentBuild.currentResult} - Build #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                attachmentsPattern: 'trivy-reports/*.txt,zap-reports/*.html',
                body: """
                <html>
                <body>

                <h2>SecDO DevSecOps Pipeline Report</h2>

                <table border="1" cellpadding="8" cellspacing="0">
                    <tr>
                        <th>Project</th>
                        <td>${env.JOB_NAME}</td>
                    </tr>

                    <tr>
                        <th>Build Number</th>
                        <td>${env.BUILD_NUMBER}</td>
                    </tr>

                    <tr>
                        <th>Status</th>
                        <td>${currentBuild.currentResult}</td>
                    </tr>

                    <tr>
                        <th>Build URL</th>
                        <td>
                            <a href="${env.BUILD_URL}">
                                ${env.BUILD_URL}
                            </a>
                        </td>
                    </tr>
                </table>

                <br>

                <h3>Security Stages</h3>

                <ul>
                    <li> SonarQube (SAST)</li>
                    <li> Trivy Image Scan</li>
                    <li> OWASP ZAP Baseline Scan</li>
                </ul>

                <p>
                Trivy and ZAP reports are attached with this email if they were generated successfully.
                </p>

                </body>
                </html>
                """
            )

            cleanWs()
        }
    }
}
