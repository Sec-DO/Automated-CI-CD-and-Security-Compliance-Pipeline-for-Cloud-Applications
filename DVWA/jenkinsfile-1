def FAILED_STAGE = "Not Available"
pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/Sec-DO/Automated-CI-CD-and-Security-Compliance-Pipeline-for-Cloud-Applications.git'
        BRANCH = 'main'
        COMPOSE_PROJECT = 'dvwa'
        TARGET_URL = 'http://15.252.71.195:4280'
		EMAIL_TO = 'patilrahulprafulla1@gmail.com,rushikeshdange49@gmail.com,ameybhalerao004@gmail.com,ashutoshkabade1961@gmail.com,dangerushi19@gmail.com'
    }

    options {
        timestamps()
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Source Code') {
            steps {
				script {
							FAILED_STAGE = "Checkout Source Code"
						}
                git branch: "${BRANCH}", url: "${REPO_URL}"
            }
        }

        stage('Verify Environment') {
            steps {
				script {
								FAILED_STAGE = "Verify Environment"
							}

			
                sh '''
                echo "========================================"
                echo "Docker Version"
                docker --version

                echo ""
                echo "Docker Compose Version"
                docker compose version

                echo ""
                echo "Docker Buildx Version"
                docker buildx version || true

                echo ""
                echo "Trivy Version"
                trivy --version

                echo ""
                echo "Repository Structure"
                pwd
                ls -la
                ls -la DVWA
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
				script {
							FAILED_STAGE = "SonarQube Analysis"
						}
                dir('DVWA') {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        withSonarQubeEnv('SonarScanner') {
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Deploy DVWA') {
            steps {
				script {
							FAILED_STAGE = "Deploy DVWA"
						}
                dir('DVWA') {
                    sh '''
                    docker compose -p ${COMPOSE_PROJECT} down || true
                    docker compose -p ${COMPOSE_PROJECT} pull
                    docker compose -p ${COMPOSE_PROJECT} up -d
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
				script {
							FAILED_STAGE = "Trivy Image Scan"
						}
                sh '''
                mkdir -p trivy-reports

                echo "========================================"
                echo "Scanning DVWA Image"
                echo "========================================"

                trivy image \
                  --severity HIGH,CRITICAL \
                  --format table \
                  --exit-code 0 \
                  -o trivy-reports/dvwa-report.txt \
                  ghcr.io/digininja/dvwa:latest

                echo "========================================"
                echo "Scanning MariaDB Image"
                echo "========================================"

                trivy image \
                  --severity HIGH,CRITICAL \
                  --format table \
                  --exit-code 0 \
                  -o trivy-reports/mariadb-report.txt \
                  mariadb:10

                cat trivy-reports/dvwa-report.txt
                cat trivy-reports/mariadb-report.txt
                '''
            }
        }

        stage('OWASP ZAP Scan') {
            steps {
				script {
							FAILED_STAGE = "OWASP ZAP Scan"
						}
                script {

                    sh 'mkdir -p zap-reports'

                    int zapStatus = sh(
                        script: """
                        docker run --rm \
                          --network host \
                          --user root \
                          -v \$(pwd)/zap-reports:/zap/wrk \
                          ghcr.io/zaproxy/zaproxy:stable \
                          zap-baseline.py \
                          -t ${TARGET_URL} \
                          -r zap-report.html
						  # -r zap-report.txt
                        """,
                        returnStatus: true
                    )

                    echo "ZAP Exit Code: ${zapStatus}"

                    if (zapStatus == 3) {
                        error("OWASP ZAP execution failed.")
                    }

                    if (zapStatus == 1) {
                        error("OWASP ZAP detected FAIL findings.")
                    }

                    if (zapStatus == 2) {
                        echo "OWASP ZAP reported WARN findings. Continuing pipeline."
                    }

                    sh '''
                    echo "Generated Reports"
                    ls -lah zap-reports || true
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
				script {
							FAILED_STAGE = "Verify Deployment"
						}
                dir('DVWA') {
                    sh '''
                    echo "========================================"
                    echo "Running Containers"
                    docker ps

                    echo ""
                    docker compose -p ${COMPOSE_PROJECT} ps

                    echo ""
                    echo "Docker Images"
                    docker images
                    '''
                }
            }
        }
    }

    post {

    always {

        archiveArtifacts(
            artifacts: '''
                trivy-report.html,
                zap-reports/*.html,
                zap-reports/*.yaml,
                **/*.log
            ''',
            allowEmptyArchive: true
        )

    }

    success {

        emailext(
            subject: "✅ SUCCESS | SecDO Pipeline #${BUILD_NUMBER}",
            mimeType: 'text/html',

            body: """
				<html>
				<body>

				<h2 style="color:green;">✅ SecDO Pipeline Completed Successfully</h2>

				<table border="1" cellpadding="6" cellspacing="0">
					<tr><td><b>Project</b></td><td>${JOB_NAME}</td></tr>
					<tr><td><b>Build Number</b></td><td>#${BUILD_NUMBER}</td></tr>
					<tr><td><b>Status</b></td><td><font color="green"><b>SUCCESS</b></font></td></tr>
					<tr><td><b>Branch</b></td><td>${BRANCH}</td></tr>
					<tr><td><b>Build URL</b></td><td><a href="${BUILD_URL}">${BUILD_URL}</a></td></tr>
					<tr><td><b>Application</b></td><td><a href="${TARGET_URL}">${TARGET_URL}</a></td></tr>
					<tr><td><b>SonarQube</b></td><td><a href="http://${HOST}:9000">View Dashboard</a></td></tr>
				</table>

				<br>

				<h3>Pipeline Summary</h3>

				<table border="1" cellpadding="5" cellspacing="0">
				<tr>
					<th>Stage</th>
					<th>Status</th>
				</tr>

				<tr><td>Checkout Source Code</td><td>✅ Passed</td></tr>
				<tr><td>SonarQube Analysis</td><td>✅ Passed</td></tr>
				<tr><td>Build Docker Image</td><td>✅ Passed</td></tr>
				<tr><td>Trivy Image Scan</td><td>✅ Passed</td></tr>
				<tr><td>Docker Push</td><td>✅ Passed</td></tr>
				<tr><td>Deployment</td><td>✅ Passed</td></tr>
				<tr><td>OWASP ZAP Scan</td><td>✅ Passed</td></tr>

				</table>

				<br>

				<h3>Attached Reports</h3>

				<ul>
				<li>📄 Trivy Image Scan Report</li>
				<li>📄 OWASP ZAP HTML Report</li>
				</ul>

				<br>

				<p>
				The application was successfully built, scanned, deployed and verified.
				</p>

				<br>

				Regards,<br>
				<b>SecDO DevSecOps Pipeline</b>

				</body>
				</html>
				""",

							attachmentsPattern: '''
								trivy-report.html,
								zap-reports/*.html,
								zap-reports/*.yaml,
								**/*.log
							''',

							to: "${EMAIL_TO}"
						)
					}

					failure {

						emailext(
							subject: "❌ FAILED | SecDO Pipeline #${BUILD_NUMBER}",
							mimeType: 'text/html',

							body: """
				<html>
				<body>

				<h2 style="color:red;">❌ SecDO Pipeline Failed</h2>

				<table border="1" cellpadding="6" cellspacing="0">
				<tr><td><b>Project</b></td><td>${JOB_NAME}</td></tr>
				<tr><td><b>Build Number</b></td><td>#${BUILD_NUMBER}</td></tr>
				<tr><td><b>Status</b></td><td><font color="red"><b>FAILED</b></font></td></tr>
				<tr><td><b>Failed Stage</b></td><td>${FAILED_STAGE}</td></tr>
				<tr><td><b>Build URL</b></td><td><a href="${BUILD_URL}">${BUILD_URL}</a></td></tr>
				</table>

				<br>

				<p>
				Please review the attached reports and Jenkins console log.
				</p>

				</body>
				</html>
				""",

							attachmentsPattern: '''
								trivy-report.html,
								zap-reports/*.html,
								zap-reports/*.yaml,
								**/*.log
							''',

							to: "${EMAIL_TO}"
			)
		}
	}
	
}

